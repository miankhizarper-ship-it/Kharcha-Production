// Cloudflare Workers config — Kharcha landing page (Next.js via OpenNext).
// Build: npx opennextjs-cloudflare build → .open-next/worker.js + assets.
// No Worker variables or secrets are required: the release control file
// (public/app_version.json) ships inside the bundle.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kharcha-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  }
}
